<Window x:Class="BlackMoon.Host.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="BlackMoon Host WPF"
        Height="720"
        Width="1180">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#111827" Padding="16">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Start Backend" Margin="0,0,8,0" Padding="12,6" Click="StartBackend_Click" />
                    <Button Content="Stop Backend" Margin="0,0,8,0" Padding="12,6" Click="StopBackend_Click" />
                    <Button Content="Start Front" Margin="0,0,8,0" Padding="12,6" Click="StartFront_Click" />
                    <Button Content="Open Front" Padding="12,6" Click="OpenFront_Click" />
                </StackPanel>

                <StackPanel Orientation="Vertical" DockPanel.Dock="Right">
                    <TextBlock Foreground="White" FontSize="22" FontWeight="SemiBold" Text="BlackMoon WPF Host" />
                    <TextBlock Foreground="#D1D5DB" Text="WPF host that exposes the gRPC backend for the Blazor front-end" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="1.4*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#F9FAFB" CornerRadius="8" Padding="16" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Service Host" />
                    <TextBlock Margin="0,8,0,0" Text="Le host WPF demarre et expose les services gRPC sur localhost." />

                    <StackPanel Margin="0,20,0,0">
                        <TextBlock FontWeight="SemiBold" Text="Backend gRPC" />
                        <TextBlock x:Name="BackendStatusText" Margin="0,6,0,0" Text="Stopped" />
                        <TextBlock Margin="0,4,0,0">
                            <Run Text="URL: " />
                            <Hyperlink NavigateUri="http://localhost:5117" RequestNavigate="Hyperlink_RequestNavigate">
                                <Run Text="http://localhost:5117" />
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Margin="0,20,0,0">
                        <TextBlock FontWeight="SemiBold" Text="Front Blazor" />
                        <TextBlock x:Name="FrontStatusText" Margin="0,6,0,0" Text="Stopped" />
                        <TextBlock Margin="0,4,0,0">
                            <Run Text="URL: " />
                            <Hyperlink NavigateUri="http://localhost:5000" RequestNavigate="Hyperlink_RequestNavigate">
                                <Run Text="http://localhost:5000" />
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Margin="0,20,0,0" TextWrapping="Wrap"
                               Text="Le front Blazor consomme le backend gRPC expose par ce host WPF. Le backend n'a plus besoin d'etre lance comme application web separee quand ce host est utilise." />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="#111827" CornerRadius="8" Padding="16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Foreground="White" FontSize="20" FontWeight="SemiBold" Text="Journal" />
                    <ListBox x:Name="LogList" Margin="0,12,0,0" Background="#111827" BorderThickness="0" Foreground="#E5E7EB" />
                </DockPanel>
            </Border>
        </Grid>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
